<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:background">@drawable/pill</item>
        <item name="android:focusable">true</item>
        <item name="android:maxWidth">280dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
