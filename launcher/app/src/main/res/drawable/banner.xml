<?xml version="1.0" encoding="utf-8"?>
<!-- 16:9 launcher banner: a black card with a soft white glow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
        </shape>
    </item>
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="160dp"
                android:startColor="#66FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
